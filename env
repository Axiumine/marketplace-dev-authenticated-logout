PORT=4030
DOMAIN=xxx.tdweb.lan

REDIS_IS_CLUSTER=1
#
# Read ONLY when REDIS_IS_CLUSTER is not exactly the string '1'. koa-utils then builds a single-node
# createClient({ url: REDIS_URL }) and ignores every REDIS_DB1..DB3 pair below. Empty because this
# stack runs the cluster branch — but an empty value is not an error on the other branch: node-redis
# falls back to redis://localhost:6379 and connects to the wrong server instead of refusing. Set it
# before flipping the flag.
REDIS_URL=
REDIS_DB1_HOST=db1
REDIS_DB2_HOST=db2
REDIS_DB3_HOST=db3
REDIS_DB1_PORT=6379
REDIS_DB2_PORT=6379
REDIS_DB3_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_KEY=marketplaceDev:


NODE_ENV=development


UPLOAD_DIR=/media/xxx
MAX_IMAGE_MB=20
MAX_VIDEO_MB=100

SOCKETLABS_SERVER_ID=111111
SOCKETLABS_SERVER_APIKEY=xxxxxx
REDIRECT_DOMAIN=https://xxxx.tdweb.lan

HIT_STATS=false
# ⚠️ Development-only, and the gate is code rather than convention (E13-S11): the
# `x-introspectioncode` header is honoured only when NODE_ENV is exactly `development` or `test`, and
# refused under every other value — unset, empty, `staging`, `Production`, a typo. In production it
# does nothing at all, and a request carrying it is answered exactly as one carrying nothing.
# Still required at boot: unset, `${process.env.INTROSPECTION_CODE}` stringifies to the literal
# 'undefined', so a service mislabelled as development would hand the bypass to anyone sending that
# word. Two things have to be wrong before it opens, and this variable is the second.
INTROSPECTION_CODE='xxx'

# ⚠️ The key that opens the cookie-signing keys, not a signing key itself (ADR-034). The keys live in
# one Redis record shared by the five services that sign or read a session cookie; this unwraps it, and
# a service whose value is not the one the record was written under refuses to boot rather than sign
# cookies its siblings cannot verify. Base64 of exactly 32 bytes — `openssl rand -base64 32`.
# The same value in all five services. Rotating the signing keys does NOT require changing this.
KEYGRIP_KEK="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# ⚠️ Dead since ADR-034 and read by nothing — kept only until E01-S15 sweeps the name out of every
# template. The signing keys are the Redis record above; editing these two changes nothing.
KEYGRIP_KEY_1=="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
KEYGRIP_KEY_2="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional: an empty or missing DSN leaves the Sentry SDK inert and the service still boots.
# Deliberately absent from REQUIRED_ENV_VARS in src/index.mts — do not add it back.
DSN="https://xxxxxxxxxxxxxx@bugsink.lan/1"


